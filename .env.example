# Local development defaults (no real secrets). Copy to .env if needed.
LOG_LEVEL=info
HTTP_ADDR=:8080

# From the host machine use localhost; inside Docker Compose use service names (postgres, mosquitto, rabbitmq).
DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet?sslmode=disable
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=fleet-api
# Optional broker credentials (leave empty for an anonymous broker).
MQTT_USERNAME=
MQTT_PASSWORD=
RABBITMQ_URL=amqp://fleet:fleet@localhost:5672/

# Demo default = example coordinate from the test PDF (not an official Transjakarta location).
GEOFENCE_CENTER_LAT=-6.2088
GEOFENCE_CENTER_LON=106.8456
GEOFENCE_RADIUS_M=50

MAX_FUTURE_SKEW=5m
MAX_HISTORY_RANGE=744h
OUTBOX_RETENTION=24h

# Mock publisher only
PUBLISH_INTERVAL=2s
PUBLISHER_CLIENT_ID=fleet-publisher
